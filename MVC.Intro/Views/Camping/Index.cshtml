@model IEnumerable<CampingTent>
@inject ImageStorageService Images
@{
    Layout = "_CampingLayout";
    ViewData["Title"] = "Къмпинг Природа";
}

<section id="home" class="hero">
    <div class="hero-content">
        <h1>Открийте красотата на природата</h1>
        <p>Ние предлагаме най-добрите палатки за вашия незабравим къмпинг опит</p>
        <a href="#products" class="cta-button">Разгледайте палатките</a>
    </div>
</section>

<section id="products" class="products">
    <div class="container">
        <h2>Нашите палатки</h2>
        <p class="section-subtitle">Висококачествени палатки за всякакви приключения</p>

        <div class="products-grid">
            @foreach (var tent in Model)
            {
                var features = (tent.Features ?? string.Empty)
                    .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
                <div class="product-card">
                    <div class="product-image">
                        <img src="@Images.ToWebPath(tent.ImagePath)" alt="@tent.Name"
                             onerror="this.onerror=null;this.src='/images/tent-placeholder.svg';" />
                    </div>
                    <div class="product-info">
                        <h3>@tent.Name</h3>
                        <p class="product-description">@tent.Description</p>
                        <div class="product-features">
                            <span>👥 @tent.Capacity души</span>
                            @if (tent.IsWaterproof)
                            {
                                <span>💧 Водоустойчива</span>
                            }
                            @if (tent.HasVentilation)
                            {
                                <span>🌬️ Вентилация</span>
                            }
                            @foreach (var feature in features)
                            {
                                <span>@feature</span>
                            }
                        </div>
                        <div class="product-price">
                            <span class="price">@tent.Price.ToString("0.##") лв.</span>
                            <button type="button" class="buy-button"
                                    data-name="@tent.Name"
                                    data-price="@tent.Price.ToString(System.Globalization.CultureInfo.InvariantCulture)">Купи</button>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<section id="about" class="about">
    <div class="container">
        <h2>За нас</h2>
        <div class="about-content">
            <div class="about-text">
                <p>Къмпинг Природа е ваш доверен партньор в света на къмпинга. Ние предлагаме висококачествено оборудване за всички ваши приключения на открито.</p>
                <p>С над 10 години опит в бранша, ние подбираме само най-добрите продукти, за да гарантираме вашето удобство и безопасност.</p>

                <div class="features">
                    <div class="feature">
                        <div class="feature-icon">✅</div>
                        <h3>Качество</h3>
                        <p>Само сертифицирани продукти</p>
                    </div>
                    <div class="feature">
                        <div class="feature-icon">🚚</div>
                        <h3>Бърза доставка</h3>
                        <p>До 2 работни дни</p>
                    </div>
                    <div class="feature">
                        <div class="feature-icon">🔄</div>
                        <h3>Връщане</h3>
                        <p>30 дни гаранция</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section id="contact" class="contact">
    <div class="container">
        <h2>Свържете се с нас</h2>
        <form class="contact-form" onsubmit="handleSubmit(event)">
            <div class="form-group">
                <input type="text" name="name" placeholder="Вашето име" required>
            </div>
            <div class="form-group">
                <input type="email" name="email" placeholder="Email адрес" required>
            </div>
            <div class="form-group">
                <textarea name="message" placeholder="Вашето съобщение" rows="5" required></textarea>
            </div>
            <button type="submit" class="submit-button">Изпрати съобщение</button>
        </form>
    </div>
</section>

<div id="cart-modal" class="modal" role="dialog" aria-modal="true" aria-labelledby="cart-title">
    <div class="modal-content">
        <button type="button" class="close" onclick="closeCart()" aria-label="Затвори">&times;</button>
        <h2 id="cart-title">Вашата количка</h2>
        <div id="cart-items"></div>
        <div class="cart-total">
            <strong>Общо: <span id="cart-total">0</span> лв.</strong>
        </div>
        <button type="button" class="checkout-button" onclick="checkout()">Поръчай</button>
    </div>
</div>

<button type="button" class="cart-button" onclick="openCart()" aria-label="Отвори количката">
    🛒 <span id="cart-count">0</span>
</button>
